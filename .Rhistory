df_4d <- df_long %>%
dplyr::fitler(drug != "CBX") %>%
dplyr::mutate(drug = drug %>%
forcats::fct_drop() %>%
forcats::fct_relevel("Veh", after  = 0)) %>%
dplyr::mutate(block = case_when(day %in% 1:4 ~ 1,
day %in% 5:8 ~ 2,
day %in% 9:12 ~ 3,
day %in% 13:16 ~ 4)) %>%
dplyr::group_by(id, block, month, genotype, drug) %>%
dplyr::summarise(wm4m = mean(wm),
rm4m = mean(rm)) %>%
dplyr::ungroup()
df_4d <- df_long %>%
dplyr::filter(drug != "CBX") %>%
dplyr::mutate(drug = drug %>%
forcats::fct_drop() %>%
forcats::fct_relevel("Veh", after  = 0)) %>%
dplyr::mutate(block = case_when(day %in% 1:4 ~ 1,
day %in% 5:8 ~ 2,
day %in% 9:12 ~ 3,
day %in% 13:16 ~ 4)) %>%
dplyr::group_by(id, block, month, genotype, drug) %>%
dplyr::summarise(wm4m = mean(wm),
rm4m = mean(rm)) %>%
dplyr::ungroup()
df_3d <- df_long %>%
dplyr::filter(day > 1) %>%
dplyr::filter(drug != "CBX") %>%
dplyr::mutate(drug = drug %>%
forcats::fct_drop() %>%
forcats::fct_relevel("Veh", after  = 0)) %>%
dplyr::mutate(block = case_when(day %in% 2:4 ~ 1,
day %in% 5:7 ~ 2,
day %in% 8:10 ~ 3,
day %in% 11:13 ~ 4,
day %in% 14:16 ~ 5)) %>%
dplyr::group_by(id, block, month, genotype, drug) %>%
dplyr::summarise(wm3m = mean(wm),
rm3m = mean(rm)) %>%
dplyr::ungroup()
fit_wm4m <- afex::aov_4(wm4m ~ genotype*drug + (block|id),
data = df_4d)
summmary(fit_wm4m)
summary(fit_wm4m)
fit_wm3m <- afex::aov_4(wm3m ~ genotype*drug + (block|id),
data = df_3d)
summary(fit_wm3m)
